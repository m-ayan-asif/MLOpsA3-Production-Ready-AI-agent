# Copy to .env (never commit .env). Export with: set -a; source .env; set +a
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT=mlops-agent-demo

AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=change-me-locally
APPROVED_DAG_IDS=ml_training_pipeline

K8S_ALLOWED_NAMESPACES=mlops-agent
K8S_APP_LABEL=app.kubernetes.io/name=inference-api
K8S_DEPLOYMENT=inference-api
K8S_CONFIGMAP=inference-config

DVC_REPO_PATH=.
QUALITY_GATE_F1=0.93
MODEL_FRESHNESS_DAYS=30
